// winRice fetch — Tokyo Night
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__LOGO__",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 16 },
    "color": { "keys": "blue", "title": "magenta" },
    "percent": { "type": ["num", "bar"] }
  },
  "modules": [
    "title",
    "os",
    "kernel",
    "uptime",
    "wm",
    "shell",
    "terminal",
    { "type": "display", "key": "Monitor" },
    "cpu",
    "gpu",
    "memory",
    "disk",
    { "type": "localip", "key": "IP" },
    "break",
    "colors"
  ]
}
